# DB credentials (used for both direct and SSH tunnel connections).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# DB_SOCKET=/var/run/mysqld/mysqld.sock  # Unix socket (overrides host/port)

# Business pricing (positive integer cents). Replace all zero placeholders;
# they are required for allocation but are not rejected by the current loader.
BOX_PRICE_SMALL=0
BOX_PRICE_MEDIUM=0
BOX_PRICE_LARGE=0
BOX_TARGET_PCT=100             # Target box value as % of price (e.g. 100 = 100%)
VALUE_SWEET_FROM=110           # Sweet spot lower bound (% of box price, 0 penalty)
VALUE_SWEET_TO=120             # Sweet spot upper bound (% of box price, 0 penalty)
VALUE_PENALTY_EXPONENT=2       # Power curve exponent (higher = harsher far deviations)
CHARITY_NAME=Charity           # Charity recipient name (used as default header label)
CHARITY_BASE_PERCENT=0.0       # Base charity allocation as fraction of total overage value
CHARITY_GIVING_MULTIPLIER=2.0  # Multiplier on giving items for charity target

# SSH tunnel (optional). Set SSH_ENABLED=true and choose one auth method.
SSH_ENABLED=false
# SSH_HOST=192.0.2.1
# SSH_PORT=22
# SSH_USER=deploy
# SSH_REMOTE_BIND_HOST=localhost  # defaults to DB_HOST
# SSH_REMOTE_BIND_PORT=3306      # defaults to DB_PORT
#
# Key-based auth (recommended):
# SSH_KEY_PATH=~/.ssh/id_rsa
# SSH_KEY_PASSPHRASE=          # optional
#
# Password-based auth:
# SSH_PASSWORD=your_ssh_password
